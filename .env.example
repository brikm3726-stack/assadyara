# ------------------------------------------------------------------
# Copiez ce fichier en « .env », remplissez, puis relancez le build.
# Vite fige ces valeurs à la compilation : après chaque modification,
# il faut rebuilder ET redéployer.
# ------------------------------------------------------------------

# --- Hub e-commerce : les commandes arrivent dans le dashboard -----
# Dashboard → Produits : créez UN produit par offre (le hub facture le
# prix du produit, il ignore celui envoyé par la page).
#   • pack   « أسد + يارا »  → 3700 دج
#   • unité  « علبة واحدة »  → 2200 دج
# Dashboard → Landing pages : connectez cette page, notez son code.
VITE_HUB_URL=https://ecom-hub-cyan.vercel.app
VITE_HUB_LANDING_ID=
VITE_HUB_PRODUIT_PACK=
VITE_HUB_PRODUIT_UNITE=

# --- Alerte e-mail (facultatif, cumulable avec le hub) -------------
# Clé gratuite sur https://web3forms.com — joignable depuis l'Algérie.
VITE_WEB3FORMS_KEY=

# --- Autre destination JSON (facultatif) ---------------------------
VITE_COMMANDE_ENDPOINT=

# --- Meta Pixel (Facebook Ads) -------------------------------------
# Événements : PageView, ViewContent, InitiateCheckout, Lead, Purchase.
VITE_PIXEL_ID=
