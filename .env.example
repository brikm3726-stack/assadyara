# ------------------------------------------------------------------
# Copiez ce fichier en « .env », remplissez, puis relancez « npm run build ».
# Aucune de ces valeurs n'est obligatoire : sans elles, la page fonctionne
# en mode démo (commande enregistrée dans le navigateur, événements Pixel
# affichés dans la console).
# ------------------------------------------------------------------

# Meta Pixel (Facebook Ads). Identifiant à 15 ou 16 chiffres.
# Événements envoyés : PageView, ViewContent, InitiateCheckout, Lead, Purchase.
VITE_PIXEL_ID=

# Réception des commandes — option 1 : Web3Forms (le plus simple, e-mail).
# Clé gratuite sur https://web3forms.com — fiable depuis l'Algérie.
VITE_WEB3FORMS_KEY=

# Réception des commandes — option 2 : votre propre URL en POST JSON
# (Google Apps Script, Supabase, n8n, Make, votre API…).
VITE_COMMANDE_ENDPOINT=
